# 环境变量模板
#
# 用法（推荐）：
#   1. 复制本文件为 .env        cp .env.example .env
#   2. 按需修改里面的值
#   3. docker compose up -d --build
#
# .env 已被 .gitignore 排除，不会提交到 Git，Key 不会泄漏。
# 如果你不用 .env，也可以在网页里手填，效果一样。

# ---------- 监听 ----------
# 端口
PORT=8787
# 监听地址。Docker 里必须 0.0.0.0
HOST=0.0.0.0

# ---------- 端口暴露范围（安全，重要！） ----------
#
# 想直接用浏览器访问 → 填 0.0.0.0（默认）
#   然后把阿里云安全组 8787 端口放行（强烈建议只放行你自己的 IP）
#   浏览器打开：http://服务器公网IP:8787
#
# 想更安全、不暴露到公网 → 填 127.0.0.1，走 SSH 隧道：
#   ssh -L 8787:127.0.0.1:8787 root@你的服务器IP
#   之后本地浏览器打开 http://127.0.0.1:8787
#
# 注意：填 127.0.0.1 时从公网是绝对连不上的（这是有意为之）。
#       以前默认值是 127.0.0.1，很多人因此以为「部署失败」，故改为 0.0.0.0。
BIND_IP=0.0.0.0

# ---------- 镜像版本（仅 docker-compose.ghcr.yml 用得到） ----------
# 留空/不写 = 用 latest，跟着仓库 main 分支的最新构建走。
#   IMAGE_TAG=latest     每次 up -d 都拉最新（compose 里 pull_policy: always 保证生效）
# 想锁定版本不被意外升级：
#   IMAGE_TAG=1.2.3      只认这个版本号，升级要手动改这里
IMAGE_TAG=latest

# ---------- TMDB ----------
# 域名。api.themoviedb.org 国内常无法访问，默认用 api.tmdb.org
TMDB_HOST=api.tmdb.org
# 海报图床域名（与 api 域名不同）。如 image.tmdb.org 访问不了可换镜像
TMDB_IMAGE_HOST=image.tmdb.org
# 请求超时（毫秒）
TMDB_TIMEOUT=12000

# ---------- 预设配置（可选） ----------
# 填了之后网页会自动带上，省得手输。留空也行。
# 注意：容器内不要写 localhost。
#   - Emby 装在宿主机上        用 host.docker.internal
#   - Emby 在另一台机器/群晖    用实际内网 IP
EMBY_URL=
EMBY_KEY=
TMDB_KEY=

# ---------- 数据持久化 ----------
# 扫描结果存放目录（容器内路径，已在 compose 里挂到宿主机 ./data）。
# 一般不用改。换路径时记得同步改 docker-compose.yml 的 volumes。
DATA_DIR=/app/data

# 工作区元数据，与工具无关
.workbuddy/

# 本地环境变量（如果之后你用 .env 存 Key，绝不要提交）
.env
.env.local
*.env

# 预设配置（含 Emby 地址 / API Key，绝不要提交）
config.json

# 日志与临时文件
*.log
*.tmp

# 备份文件（改动前的本地快照）
*.bak

# 扫描结果（本地数据，不上传）
data/

# ---------------------------------------------------------------
# 测试 / 调试脚本：常含真实 Emby 地址与 API Key，绝不提交！
# 以 _ 开头的文件基本都是这类临时脚本
# ---------------------------------------------------------------
_*.js
_*.mjs
_*.sh
_*.md
_*.txt
*.test.local.js
e2e*.js
*e2e*.js

# 本机专用资料（含 SSH 公钥、私钥路径等，只存本机）
*本机专用*

# Windows 一键脚本在 Linux 服务器上用不到，但保留在仓库里也无妨
# （如果你想精简仓库，可以取消下面这行的注释）
# *.bat
